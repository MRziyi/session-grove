{
  "name": "session-grove",
  "version": "0.15.2",
  "private": true,
  "description": "A project-centered workspace for branching and managing agent sessions.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/session-grove.js",
    "stop": "node bin/session-grove.js stop",
    "status": "node bin/session-grove.js status",
    "dev": "node --watch bin/session-grove.js",
    "demo": "node bin/session-grove.js --demo",
    "test": "node --test test/*.test.js",
    "test:claude": "node scripts/claude-smoke.js",
    "test:conversion": "node scripts/conversion-smoke.js",
    "test:codex": "node scripts/codex-smoke.js",
    "test:codex-fork": "node scripts/codex-fork-smoke.js",
    "test:browser": "node scripts/node-browser-smoke.js && node scripts/sync-browser-smoke.js",
    "test:node-browser": "node scripts/node-browser-smoke.js",
    "test:sync-browser": "node scripts/sync-browser-smoke.js",
    "bench:sync": "node --expose-gc scripts/sync-benchmark.js",
    "bench:store": "node --expose-gc scripts/store-benchmark.js",
    "bench:provider": "node scripts/provider-benchmark.js",
    "migrate:git": "node scripts/migrate-git.js"
  },
  "bin": {
    "session-grove": "bin/session-grove.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283"
  }
}
